# Sanitized homelab fixture derived from a real-world configuration.

{
	# Exercise global options and nested blocks.
	servers {
		protocols h1 h2 h3
	}

	# Optional global logging configuration.
	# log {
	# 	output file /var/log/caddy/access.log {
	# 		roll_size 10MB
	# 		roll_keep 5
	# 		roll_keep_for 720h
	# 	}
