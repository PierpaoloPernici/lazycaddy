# Standard HTTP reverse proxy snippet.
(reverse_proxy_http) {
	reverse_proxy {args[0]} {
		header_up Upgrade {http.request.header.Upgrade}
		header_up Connection {http.request.header.Connection}
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}
}

# HTTPS reverse proxy snippet for self-signed upstream certificates.
(reverse_proxy_https) {
	reverse_proxy {args[0]} {
		transport http {
			tls_insecure_skip_verify
		}
		header_up Upgrade {http.request.header.Upgrade}
		header_up Connection {http.request.header.Connection}
		header_up X-Real-IP {remote_host}
		header_up Host {host}
	}
}

# Wildcard TLS configuration for the sanitized example domain.
*.example.test {
	tls {
		# Requires a Caddy build with the Cloudflare DNS module.
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		protocols tls1.2 tls1.3
	}

	header {
		# Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

